# ---------------------------------------------------------------------------
# Silvaine storefront — frontend environment
#
# Only VITE_-prefixed variables reach the browser bundle, and everything in it
# is public by definition. No secret belongs in this file: the API holds the
# JWT secrets, database credentials and payment keys, and the browser never
# sees them.
# ---------------------------------------------------------------------------

# Base URL of the Silvano API, including the version prefix.
# Local development:  http://localhost:3000/api/v1
# Production:         https://api.silvaine.example/api/v1
VITE_API_BASE_URL=http://localhost:3000/api/v1
